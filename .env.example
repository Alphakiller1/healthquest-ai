# Public Supabase settings. The anon key is safe to expose. Never put the service role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Default is the current cost-efficient model verified 2026-09-24.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# USDA FoodData Central. Official default limit is 1,000 requests/hour/IP. Do not ship DEMO_KEY.
USDA_FOODDATA_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

AI_DAILY_LIMIT_FREE=30

# Leave empty until scrubbing is configured. Do not enable on authenticated routes before that.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
